# TimescaleDB (container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-.env
POSTGRES_DB=telemetry

# Telegraf uses the same database credentials
TELEGRAF_PGPASSWORD=change-me-in-.env

# Grafana admin + provisioning
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-in-.env

# Host-side connection for Python scripts (psycopg)
DATABASE_URL=postgresql://postgres:change-me-in-.env@localhost:5432/telemetry

# Live stream tuning (optional)
STREAM_STATE_DIR=./state
SCENARIO_TICK_SECONDS=60